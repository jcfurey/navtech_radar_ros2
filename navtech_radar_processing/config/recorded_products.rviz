Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: navtech
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Image
    Name: Recorded polar image
    Enabled: true
    Topic:
      Reliability Policy: Best Effort
      Value: /navtech_radar/fft/display
  - Class: rviz_default_plugins/Image
    Name: Recorded Cartesian image
    Enabled: true
    Topic:
      Reliability Policy: Best Effort
      Value: /navtech_radar/fft/cartesian
  - Class: rviz_default_plugins/PointCloud2
    Name: Recorded detections
    Enabled: true
    Size (m): 0.1
    Color Transformer: FlatColor
    Topic:
      Reliability Policy: Best Effort
      Value: /navtech_radar/point_cloud
  - Class: rviz_default_plugins/LaserScan
    Name: Recorded scan
    Enabled: true
    Size (m): 0.1
    Topic:
      Reliability Policy: Best Effort
      Value: /navtech_radar/scan
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 7
