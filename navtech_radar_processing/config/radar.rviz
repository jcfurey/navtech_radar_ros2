Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: navtech
    Frame Rate: 20
  Displays:
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: Enhanced FFT Range-Azimuth
    Normalize Range: false
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /navtech_radar/fft/display
    Transport Override: raw
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: Radar Top-Down
    Normalize Range: false
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /navtech_radar/fft/cartesian
    Transport Override: raw
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: false
    Max Value: 65535
    Median window: 5
    Min Value: 0
    Name: Raw FFT Range-Azimuth
    Normalize Range: true
    Topic:
      Depth: 2
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /navtech_radar/fft/image
    Transport Override: raw
    Value: false
  - Alpha: 0.9
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: Intensity
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 65535
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Navtech Radar Returns
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.08
    Style: Flat Squares
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /navtech_radar/point_cloud
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 0.9
    Autocompute Intensity Bounds: true
    Channel Name: intensity
    Class: rviz_default_plugins/LaserScan
    Color: 0; 255; 255
    Color Transformer: Intensity
    Decay Time: 0
    Enabled: true
    Max Intensity: 65535
    Min Intensity: 0
    Name: Navtech Radar Scan
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 4
    Size (m): 0.1
    Style: Flat Squares
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /navtech_radar/scan
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Radar
      Target Frame: <Fixed Frame>
      Scale: 7
